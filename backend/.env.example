# Application Settings
APP_NAME=NyayaAI Backend
APP_ENV=development
HOST=0.0.0.0
PORT=8000
DEBUG=True

# CORS Configuration (comma-separated origins)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# Google Gemini API Settings (Used for LLM Generation)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash

# Embeddings Configuration (local or gemini)
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Data & Document Ingestion
DATA_DIRECTORY=./data
CHUNK_SIZE=1200
CHUNK_OVERLAP=200
EMBEDDING_BATCH_SIZE=100

# Vectorstore / Database Path
CHROMA_PERSIST_DIRECTORY=./vectorstore
CHROMA_COLLECTION_NAME=nyaya_legal_knowledge_base
